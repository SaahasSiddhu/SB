        "# ============================================================\n",
        "# INWARD FACILITY ANALYTICS — Google Colab\n",
        "# Upload your CSV file when prompted, all tables auto-generate\n",
        "# ============================================================\n",
        "\n",
        "# ── CELL 1: Install & Imports ────────────────────────────────\n",
        "from google.colab import files\n",
        "import pandas as pd\n",
        "import re\n",
        "from IPython.display import display, HTML\n",
        "from io import StringIO\n",
        "\n",
        "pd.set_option('display.max_rows', 200)\n",
        "pd.set_option('display.max_columns', 30)\n",
        "pd.set_option('display.width', 120)\n",
        "pd.set_option('display.float_format', '{:,.2f}'.format)\n",
        "\n",
        "print(\"✅ Libraries ready. Run the next cell to upload your file.\")\n",
        "\n",
        "\n",
        "# ── CELL 2: Upload & Load File ───────────────────────────────\n",
        "uploaded = files.upload()\n",
        "filename = list(uploaded.keys())[0]\n",
        "df = pd.read_csv(filename)\n",
        "print(f\"✅ Loaded '{filename}' — {len(df)} rows, {df.shape[1]} columns\")\n",
        "print(\"\\nColumns found:\")\n",
        "for c in df.columns:\n",
        "    print(f\"  • {c}\")\n",
        "\n",
        "\n",
        "# ── CELL 3: Data Cleaning ────────────────────────────────────\n",
        "\n",
        "def normalize_driver_name(name):\n",
        "    \"\"\"\n",
        "    Normalize driver names to handle manual-input inconsistencies:\n",
        "    - Strips leading/trailing whitespace\n",
        "    - Collapses internal multiple spaces\n",
        "    - Title-cases the result\n",
        "    Examples: 'gopi  B' -> 'Gopi B', 'chikanna' -> 'Chikanna'\n",
        "    \"\"\"\n",
        "    if pd.isna(name):\n",
        "        return \"Unknown\"\n",
        "    name = str(name).strip()\n",
        "    name = re.sub(r'\\s+', ' ', name)   # collapse multiple spaces\n",
        "    return name.title()\n",
        "\n",
        "# Apply driver name normalization\n",
        "df['Driver Name Clean'] = df['Driver Name'].apply(normalize_driver_name)\n",
        "\n",
        "# Numeric safety — coerce key columns\n",
        "numeric_cols = [\n",
        "    'Received Quantity (in KG)',\n",
        "    'Rate (in Rs)',\n",
        "    'Amount (in Rs)',\n",
        "    'Total Received Qty (in KG)',\n",
        "    'Total Accepted Qty (in KG)',\n",
        "    'Total Rejected Qty (in KG)',\n",
        "    'Total Amount (in Rs)',\n",
        "    'Transportation Cost (in Rs)',\n",
        "    'Loading Cost',\n",
        "    'Additional Cost (in Rs)',\n",
        "    'Rejected Qty (in KG)',\n",
        "    'Rejected QTY (%)',\n",
        "    'Value of Accepted Qty (in Rs)',\n",
        "]\n",
        "for col in numeric_cols:\n",
        "    if col in df.columns:\n",
        "        df[col] = pd.to_numeric(df[col], errors='coerce').fillna(0)\n",
        "\n",
        "# Flag valuable materials: any row where Rate > 0 has a purchase cost\n",
        "df['Is Valuable'] = df['Rate (in Rs)'] > 0\n",
        "\n",
        "# Standardise vehicle number casing\n",
        "df['Vehicle Number'] = df['Vehicle Number'].str.strip().str.upper()\n",
        "\n",
        "print(\"✅ Data cleaning done.\")\n",
        "print(f\"\\nDriver name mapping (original → cleaned):\")\n",
        "mapping = df[['Driver Name', 'Driver Name Clean']].drop_duplicates().sort_values('Driver Name Clean')\n",
        "display(mapping.reset_index(drop=True))\n",
        "\n",
        "\n",
        "# ── CELL 4: ANALYTICS ────────────────────────────────────────\n",
        "# Each section prints a clearly labelled table.\n",
        "\n",
        "separator = \"\\n\" + \"=\" * 70 + \"\\n\"\n",
        "\n",
        "# ─── A. Vendor Location — Total Waste Received ──────────────\n",
        "print(separator)\n",
        "print(\"A.  VENDOR LOCATION — Total Waste Received (KG)\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "vl = (\n",
        "    df.groupby('Vendor Location', dropna=False)\n",
        "      .agg(\n",
        "          Total_Received_KG  = ('Total Received Qty (in KG)', 'sum'),\n",
        "          Total_Accepted_KG  = ('Total Accepted Qty (in KG)', 'sum'),\n",
        "          Total_Rejected_KG  = ('Total Rejected Qty (in KG)', 'sum'),\n",
        "          Num_Inward_Entries  = ('Inward Code', 'count'),\n",
        "      )\n",
        "      .sort_values('Total_Received_KG', ascending=False)\n",
        "      .reset_index()\n",
        ")\n",
        "vl.columns = [\n",
        "    'Vendor Location',\n",
        "    'Total Received (KG)',\n",
        "    'Total Accepted (KG)',\n",
        "    'Total Rejected (KG)',\n",
        "    'No. of Line Items',\n",
        "]\n",
        "display(vl)\n",
        "\n",
        "\n",
        "# ─── B. Vehicle — Number of Visits ──────────────────────────\n",
        "print(separator)\n",
        "print(\"B.  VEHICLE — Number of Facility Visits\")\n",
        "print(\"    (1 visit = 1 unique Inward Code)\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "vv = (\n",
        "    df.groupby('Vehicle Number', dropna=False)\n",
        "      .agg(\n",
        "          Visits          = ('Inward Code', 'nunique'),\n",
        "          Total_KG        = ('Total Received Qty (in KG)', 'sum'),\n",
        "          Driver_s_       = ('Driver Name Clean', lambda x: ', '.join(sorted(set(x)))),\n",
        "      )\n",
        "      .sort_values('Visits', ascending=False)\n",
        "      .reset_index()\n",
        ")\n",
        "vv.columns = ['Vehicle Number', 'Visit Count', 'Total Waste (KG)', 'Driver(s)']\n",
        "display(vv)\n",
        "\n",
        "\n",
        "# ─── C. Driver — Total Waste Handled ────────────────────────\n",
        "print(separator)\n",
        "print(\"C.  DRIVER — Total Waste Handled (KG)\")\n",
        "print(\"    (Names normalised for spacing/casing variations)\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "dr = (\n",
        "    df.groupby('Driver Name Clean', dropna=False)\n",
        "      .agg(\n",
        "          Total_KG         = ('Total Received Qty (in KG)', 'sum'),\n",
        "          Total_Accepted_KG= ('Total Accepted Qty (in KG)', 'sum'),\n",
        "          Trips            = ('Inward Code', 'nunique'),\n",
        "          Vehicles_Used    = ('Vehicle Number', lambda x: ', '.join(sorted(set(x)))),\n",
        "      )\n",
        "      .sort_values('Total_KG', ascending=False)\n",
        "      .reset_index()\n",
        ")\n",
        "dr.columns = [\n",
        "    'Driver Name',\n",
        "    'Total Waste Handled (KG)',\n",
        "    'Total Accepted (KG)',\n",
        "    'No. of Trips',\n",
        "    'Vehicle(s) Used',\n",
        "]\n",
        "display(dr)\n",
        "\n",
        "\n",
        "# ─── D. Valuable vs Non-Valuable Material ───────────────────\n",
        "print(separator)\n",
        "print(\"D.  VALUABLE vs NON-VALUABLE MATERIAL\")\n",
        "print(\"    Valuable = material where Rate (in Rs) > 0  (purchase cost exists)\")\n",
        "print(\"    Non-Valuable = Rate is 0  (no purchase cost)\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "val = (\n",
        "    df.groupby('Is Valuable')\n",
        "      .agg(\n",
        "          Total_Received_KG = ('Received Quantity (in KG)', 'sum'),\n",
        "          Total_Amount_Rs   = ('Amount (in Rs)', 'sum'),\n",
        "          Distinct_Materials= ('Material', 'nunique'),\n",
        "          Line_Item_Count   = ('Material', 'count'),\n",
        "      )\n",
        "      .reset_index()\n",
        ")\n",
        "val['Is Valuable'] = val['Is Valuable'].map({\n",
        "    True : 'Valuable (has purchase cost)',\n",
        "    False: 'Non-Valuable (no purchase cost)',\n",
        "})\n",
        "val.columns = [\n",
        "    'Category',\n",
        "    'Total Received (KG)',\n",
        "    'Total Amount (Rs)',\n",
        "    'Distinct Materials',\n",
        "    'Line Item Count',\n",
        "]\n",
        "# Add % split\n",
        "total_kg = val['Total Received (KG)'].sum()\n",
        "val['% of Total Weight'] = (val['Total Received (KG)'] / total_kg * 100).round(1)\n",
        "display(val)\n",
        "\n",
        "\n",
        "# ─── E. Material-Level Breakdown ────────────────────────────\n",
        "print(separator)\n",
        "print(\"E.  MATERIAL-LEVEL BREAKDOWN\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "mat = (\n",
        "    df.groupby(['Material', 'Is Valuable'])\n",
        "      .agg(\n",
        "          Total_Received_KG  = ('Received Quantity (in KG)', 'sum'),\n",
        "          Total_Accepted_KG  = ('Accepted Billed Qty (in KG)', 'sum'),\n",
        "          Total_Rejected_KG  = ('Rejected Qty (in KG)', 'sum'),\n",
        "          Avg_Rate_Rs_per_KG = ('Rate (in Rs)', 'mean'),\n",
        "          Total_Amount_Rs    = ('Amount (in Rs)', 'sum'),\n",
        "          Times_Received     = ('Inward Code', 'count'),\n",
        "      )\n",
        "      .reset_index()\n",
        "      .sort_values('Total_Received_KG', ascending=False)\n",
        ")\n",
        "mat['Is Valuable'] = mat['Is Valuable'].map({True: 'Yes', False: 'No'})\n",
        "mat.columns = [\n",
        "    'Material',\n",
        "    'Valuable?',\n",
        "    'Total Received (KG)',\n",
        "    'Total Accepted (KG)',\n",
        "    'Total Rejected (KG)',\n",
        "    'Avg Rate (Rs/KG)',\n",
        "    'Total Amount (Rs)',\n",
        "    'Times Received',\n",
        "]\n",
        "display(mat)\n",
        "\n",
        "\n",
        "# ── CELL 5: ADDITIONAL ANALYTICS ─────────────────────────────\n",
        "\n",
        "print(separator)\n",
        "print(\"F.  REJECTION ANALYSIS — By Vendor Location\")\n",
        "print(\"    (Which locations have the most waste rejected?)\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "rej = (\n",
        "    df.groupby('Vendor Location', dropna=False)\n",
        "      .agg(\n",
        "          Total_Received_KG  = ('Total Received Qty (in KG)', 'sum'),\n",
        "          Total_Rejected_KG  = ('Total Rejected Qty (in KG)', 'sum'),\n",
        "          Total_Accepted_KG  = ('Total Accepted Qty (in KG)', 'sum'),\n",
        "      )\n",
        "      .reset_index()\n",
        ")\n",
        "rej['Rejection Rate (%)'] = (\n",
        "    rej['Total_Rejected_KG'] / rej['Total_Received_KG'].replace(0, float('nan')) * 100\n",
        ").round(2)\n",
        "rej = rej.sort_values('Rejection Rate (%)', ascending=False)\n",
        "rej.columns = [\n",
        "    'Vendor Location',\n",
        "    'Total Received (KG)',\n",
        "    'Total Rejected (KG)',\n",
        "    'Total Accepted (KG)',\n",
        "    'Rejection Rate (%)',\n",
        "]\n",
        "display(rej)\n",
        "\n",
        "\n",
        "print(separator)\n",
        "print(\"G.  COST ANALYSIS — Transportation & Loading per Inward Trip\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "cost_cols = ['Inward Code', 'Date', 'Vendor Location', 'Vehicle Number',\n",
        "             'Driver Name Clean', 'Transportation Cost (in Rs)',\n",
        "             'Loading Cost', 'Additional Cost (in Rs)', 'Total Amount (in Rs)']\n",
        "cost_df = df[cost_cols].drop_duplicates(subset='Inward Code').copy()\n",
        "cost_df['Total Cost (Rs)'] = (\n",
        "    cost_df['Transportation Cost (in Rs)'] +\n",
        "    cost_df['Loading Cost'] +\n",
        "    cost_df['Additional Cost (in Rs)']\n",
        ")\n",
        "cost_df = cost_df.rename(columns={'Driver Name Clean': 'Driver Name'})\n",
        "cost_summary = (\n",
        "    cost_df.groupby('Vendor Location')\n",
        "           .agg(\n",
        "               Trips              = ('Inward Code', 'count'),\n",
        "               Avg_Transport_Rs   = ('Transportation Cost (in Rs)', 'mean'),\n",
        "               Avg_Loading_Rs     = ('Loading Cost', 'mean'),\n",
        "               Total_Cost_Rs      = ('Total Cost (Rs)', 'sum'),\n",
        "           )\n",
        "           .sort_values('Total_Cost_Rs', ascending=False)\n",
        "           .reset_index()\n",
        ")\n",
        "cost_summary.columns = [\n",
        "    'Vendor Location',\n",
        "    'Trips',\n",
        "    'Avg Transport Cost (Rs)',\n",
        "    'Avg Loading Cost (Rs)',\n",
        "    'Total Logistics Cost (Rs)',\n",
        "]\n",
        "display(cost_summary)\n",
        "\n",
        "\n",
        "print(separator)\n",
        "print(\"H.  SOURCE TYPE SUMMARY\")\n",
        "print(\"    (ULB / DWCC / Aggregator / etc.)\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "src = (\n",
        "    df.groupby('Source', dropna=False)\n",
        "      .agg(\n",
        "          Total_Received_KG  = ('Total Received Qty (in KG)', 'sum'),\n",
        "          Total_Accepted_KG  = ('Total Accepted Qty (in KG)', 'sum'),\n",
        "          Total_Amount_Rs    = ('Total Amount (in Rs)', 'sum'),\n",
        "          Distinct_Vendors   = ('Vendor Location', 'nunique'),\n",
        "          Entries            = ('Inward Code', 'count'),\n",
        "      )\n",
        "      .sort_values('Total_Received_KG', ascending=False)\n",
        "      .reset_index()\n",
        ")\n",
        "src.columns = [\n",
        "    'Source Type',\n",
        "    'Total Received (KG)',\n",
        "    'Total Accepted (KG)',\n",
        "    'Total Amount (Rs)',\n",
        "    'Distinct Vendor Locations',\n",
        "    'No. of Line Items',\n",
        "]\n",
        "display(src)\n",
        "\n",
        "\n",
        "print(separator)\n",
        "print(\"I.  PAYMENT STATUS SUMMARY\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "pay = (\n",
        "    df.drop_duplicates(subset='Inward Code')\n",
        "      .groupby('Payment Status')\n",
        "      .agg(\n",
        "          Inward_Count      = ('Inward Code', 'count'),\n",
        "          Total_Amount_Rs   = ('Total Amount (in Rs)', 'sum'),\n",
        "      )\n",
        "      .reset_index()\n",
        ")\n",
        "pay['Payment Status'] = pay['Payment Status'].map({True: 'Paid', False: 'Unpaid'})\n",
        "pay.columns = ['Payment Status', 'No. of Inward Records', 'Total Amount (Rs)']\n",
        "display(pay)\n",
        "\n",
        "\n",
        "print(separator)\n",
        "print(\"J.  DATE-WISE INWARD VOLUME\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "date_df = (\n",
        "    df.groupby('Date', dropna=False)\n",
        "      .agg(\n",
        "          Total_Received_KG = ('Total Received Qty (in KG)', 'sum'),\n",
        "          Inward_Trips      = ('Inward Code', 'nunique'),\n",
        "          Materials_Count   = ('Material', 'count'),\n",
        "          Total_Amount_Rs   = ('Total Amount (in Rs)', 'sum'),\n",
        "      )\n",
        "      .reset_index()\n",
        "      .sort_values('Date')\n",
        ")\n",
        "date_df.columns = [\n",
        "    'Date',\n",
        "    'Total Received (KG)',\n",
        "    'Inward Trips',\n",
        "    'No. of Material Entries',\n",
        "    'Total Amount (Rs)',\n",
        "]\n",
        "display(date_df)\n",
        "\n",
        "print(\"\\n✅ All analytics complete.\")\n",
        "\n",
        "\n",
        "# ── CELL 6: DOWNLOAD ALL ANALYTICS AS EXCEL ─────────────────\n",
        "# Writes every analytics table as a separate sheet in one .xlsx\n",
        "# file and triggers a browser download.\n",
        "# Must be run AFTER Cells 4 & 5 (the DataFrames must exist).\n",
        "\n",
        "import os\n",
        "from datetime import datetime\n",
        "\n",
        "def download_analytics_xlsx():\n",
        "    \"\"\"\n",
        "    Saves each analytics table (A–J) as its own named sheet\n",
        "    inside a single Excel workbook, then downloads it via Colab.\n",
        "    Filename includes a timestamp so re-runs don't overwrite.\n",
        "    \"\"\"\n",
        "\n",
        "    # Map: Excel sheet name  →  DataFrame\n",
        "    tables = {\n",
        "        \"A - Vendor Location Waste\" : vl,\n",
        "        \"B - Vehicle Visits\"        : vv,\n",
        "        \"C - Driver Waste Handled\"  : dr,\n",
        "        \"D - Valuable vs NonVal\"    : val,\n",
        "        \"E - Material Breakdown\"    : mat,\n",
        "        \"F - Rejection Analysis\"    : rej,\n",
        "        \"G - Cost Analysis\"         : cost_summary,\n",
        "        \"H - Source Type Summary\"   : src,\n",
        "        \"I - Payment Status\"        : pay,\n",
        "        \"J - Datewise Inward Vol\"   : date_df,\n",
        "    }\n",
        "\n",
        "    timestamp = datetime.now().strftime(\"%Y%m%d_%H%M%S\")\n",
        "    xlsx_name = f\"Inward_Analytics_{timestamp}.xlsx\"\n",
        "    xlsx_path = f\"/tmp/{xlsx_name}\"\n",
        "\n",
        "    written = []\n",
        "    failed  = []\n",
        "\n",
        "    with pd.ExcelWriter(xlsx_path, engine=\"openpyxl\") as writer:\n",
        "        for sheet_name, df_table in tables.items():\n",
        "            try:\n",
        "                df_table.to_excel(writer, sheet_name=sheet_name, index=False)\n",
        "\n",
        "                # ── Auto-fit column widths ──────────────────────────\n",
        "                ws = writer.sheets[sheet_name]\n",
        "                for col_cells in ws.columns:\n",
        "                    max_len = max(\n",
        "                        len(str(cell.value)) if cell.value is not None else 0\n",
        "                        for cell in col_cells\n",
        "                    )\n",
        "                    ws.column_dimensions[col_cells[0].column_letter].width = min(max_len + 4, 50)\n",
        "\n",
        "                written.append(sheet_name)\n",
        "            except Exception as e:\n",
        "                failed.append((sheet_name, str(e)))\n",
        "\n",
        "    # Report\n",
        "    print(f\"📊  Written {len(written)} sheets into '{xlsx_name}'\")\n",
        "    for tab in written:\n",
        "        print(f\"    ✅  {tab}\")\n",
        "    if failed:\n",
        "        print(\"\\n⚠️  The following sheets could not be exported:\")\n",
        "        for tab, err in failed:\n",
        "            print(f\"    ❌  {tab} — {err}\")\n",
        "\n",
        "    # Trigger browser download\n",
        "    files.download(xlsx_path)\n",
        "    print(f\"\\n⬇️  Download started: {xlsx_name}\")\n",
        "\n",
        "# Run the download\n",
        "download_analytics_xlsx()"
